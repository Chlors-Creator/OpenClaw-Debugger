<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\OpenClawDebugger.ico</ApplicationIcon>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="OpenClawDebugger.Tests.Program.cs" />
    <Compile Remove="ModelSecurityTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AlibabaCloud.SDK.SWAS-OPEN20200601" Version="4.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <Resource Include="Assets\OpenClawDebugger.ico" />
    <EmbeddedResource Include="RemoteAgentProgram.py" />
    <EmbeddedResource Include="RemotePluginOperations.py" />
    <EmbeddedResource Include="RemoteSkillOperations.py" />
    <Content Include="WebUi\**\*" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <Content Include="Assets\Backgrounds\Atri.jpg" Link="WebUi\assets\Atri.jpg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Backgrounds\Luoxi.jpg" Link="WebUi\assets\Luoxi.jpg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="GenerateBridgeContract" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true' and '$(MSBuildProjectName)' == 'OpenClawDebugger'">
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(ProjectDir)Tools\Generate-BridgeContract.ps1&quot;" WorkingDirectory="$(ProjectDir)" />
  </Target>
</Project>
