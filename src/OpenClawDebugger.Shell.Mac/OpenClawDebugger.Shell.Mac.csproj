<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-macos</TargetFramework>
    <!-- Build with the 27.2 SDK while allowing the app to run on macOS 27.0.x. -->
    <SupportedOSPlatformVersion>27.0</SupportedOSPlatformVersion>
    <RootNamespace>OpenClawDebugger</RootNamespace>
    <AssemblyName>OpenClawDebugger</AssemblyName>
    <ApplicationDisplayName>OpenClaw Debugger</ApplicationDisplayName>
    <ApplicationId>com.openclaw.debugger</ApplicationId>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <EnableCodeSigning>false</EnableCodeSigning>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>true</PublishTrimmed>
    <LinkMode>None</LinkMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenClawDebugger.Core\OpenClawDebugger.Core.csproj" />
    <ProjectReference Include="..\OpenClawDebugger.Platform.Mac\OpenClawDebugger.Platform.Mac.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 界面资源唯一真源在 shared/WebUi，与 Windows 壳引用同一份。 -->
    <Content Include="$(SharedWebUiDir)**/*"
             Link="WebUi/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
